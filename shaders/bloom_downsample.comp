#version 450

// One bloom downsample step: a 13-tap filter (Jimenez, "Next Generation Post
// Processing in Call of Duty: Advanced Warfare", 2014). The first step from the
// HDR scene uses a Karis average over the five 2x2 groups to suppress fireflies.
// Destination pixel p is centered on source texel coordinate 2p + 1.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D destination;

layout(push_constant) uniform DownsampleSettings {
    vec2 sourceTexelSize;
    // Largest UV whose bilinear footprint stays inside the source's valid region.
    vec2 sourceUvLimit;
    uvec2 destinationExtent;
    uint karisAverage;
} settings;

vec3 fetch(vec2 sourceTexel) {
    vec2 uv = min(sourceTexel * settings.sourceTexelSize, settings.sourceUvLimit);
    vec3 color = textureLod(source, uv, 0.0).rgb;
    // Guard against NaN/Inf and negative radiance leaking from the scene.
    if (any(isnan(color)) || any(isinf(color))) {
        return vec3(0.0);
    }
    return clamp(color, vec3(0.0), vec3(65000.0));
}

float karisWeight(vec3 color) {
    return 1.0 / (1.0 + dot(color, vec3(0.2126, 0.7152, 0.0722)));
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, settings.destinationExtent))) {
        return;
    }
    vec2 center = vec2(pixel) * 2.0 + 1.0;
    vec3 a = fetch(center + vec2(-2.0, -2.0));
    vec3 b = fetch(center + vec2(0.0, -2.0));
    vec3 c = fetch(center + vec2(2.0, -2.0));
    vec3 d = fetch(center + vec2(-2.0, 0.0));
    vec3 e = fetch(center);
    vec3 f = fetch(center + vec2(2.0, 0.0));
    vec3 g = fetch(center + vec2(-2.0, 2.0));
    vec3 h = fetch(center + vec2(0.0, 2.0));
    vec3 i = fetch(center + vec2(2.0, 2.0));
    vec3 j = fetch(center + vec2(-1.0, -1.0));
    vec3 k = fetch(center + vec2(1.0, -1.0));
    vec3 l = fetch(center + vec2(-1.0, 1.0));
    vec3 m = fetch(center + vec2(1.0, 1.0));

    vec3 inner = (j + k + l + m) * 0.25;
    vec3 topLeft = (a + b + d + e) * 0.25;
    vec3 topRight = (b + c + e + f) * 0.25;
    vec3 bottomLeft = (d + e + g + h) * 0.25;
    vec3 bottomRight = (e + f + h + i) * 0.25;
    vec3 result;
    if (settings.karisAverage != 0u) {
        float innerWeight = 0.5 * karisWeight(inner);
        float topLeftWeight = 0.125 * karisWeight(topLeft);
        float topRightWeight = 0.125 * karisWeight(topRight);
        float bottomLeftWeight = 0.125 * karisWeight(bottomLeft);
        float bottomRightWeight = 0.125 * karisWeight(bottomRight);
        result = (inner * innerWeight + topLeft * topLeftWeight + topRight * topRightWeight +
                  bottomLeft * bottomLeftWeight + bottomRight * bottomRightWeight) /
                 (innerWeight + topLeftWeight + topRightWeight + bottomLeftWeight + bottomRightWeight);
    } else {
        result = inner * 0.5 + (topLeft + topRight + bottomLeft + bottomRight) * 0.125;
    }
    imageStore(destination, ivec2(pixel), vec4(result, 1.0));
}
