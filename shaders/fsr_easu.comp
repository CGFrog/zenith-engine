layout(local_size_x = 8, local_size_y = 8) in;

// The tone-mapped frame (display-linear; an sRGB format decodes on fetch),
// rendered into the top-left inputMaximum + 1 texels.
layout(set = 0, binding = 0) uniform sampler2D upscaleInput;
// Gamma-2 encoded output for fsr_rcas.frag.
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D upscaledOutput;

// Mirrors EasuSettings in SpatialUpscalePass.cpp and EasuConstants.
layout(push_constant) uniform EasuSettings {
    // Output pixel p samples input position p * scale + offset, where integer
    // positions are input texel centers.
    vec2 scale;
    vec2 offset;
    ivec2 inputMaximum;
    ivec2 outputSize;
} settings;

const float minimumDivisor = 1.0e-8;

// EASU filters perceptual values; gamma 2 is FSR 1's cheap approximation.
vec3 loadPerceptual(ivec2 texel) {
    vec3 displayLinear = texelFetch(upscaleInput, clamp(texel, ivec2(0), settings.inputMaximum), 0).rgb;
    return sqrt(clamp(displayLinear, 0.0, 1.0));
}

// Luma times two in two multiply-adds.
float approximateLuma(vec3 color) { return color.b * 0.5 + (color.r * 0.5 + color.g); }

// Edge direction and length of one bilinear corner from its '+' neighborhood.
void accumulateEdge(inout vec2 direction, inout float edgeLength, float weight, float above, float left,
                    float center, float right, float below) {
    float horizontalSpan = max(abs(right - center), abs(center - left));
    float horizontalDelta = right - left;
    direction.x += horizontalDelta * weight;
    float horizontalLength = clamp(abs(horizontalDelta) / max(horizontalSpan, minimumDivisor), 0.0, 1.0);
    edgeLength += horizontalLength * horizontalLength * weight;

    float verticalSpan = max(abs(below - center), abs(center - above));
    float verticalDelta = below - above;
    direction.y += verticalDelta * weight;
    float verticalLength = clamp(abs(verticalDelta) / max(verticalSpan, minimumDivisor), 0.0, 1.0);
    edgeLength += verticalLength * verticalLength * weight;
}

// Approximate Lanczos-2 tap rotated into the edge and stretched along it.
void accumulateTap(inout vec3 color, inout float totalWeight, vec2 offset, vec2 direction, vec2 anisotropy,
                   float lobe, float clip, vec3 tapColor) {
    vec2 rotated = vec2(offset.x * direction.x + offset.y * direction.y,
                        offset.x * -direction.y + offset.y * direction.x);
    rotated *= anisotropy;
    float distanceSquared = min(dot(rotated, rotated), clip);
    // (25/16 * (2/5 * x^2 - 1)^2 - (25/16 - 1)) * (lobe * x^2 - 1)^2
    float base = 2.0 / 5.0 * distanceSquared - 1.0;
    float window = lobe * distanceSquared - 1.0;
    base *= base;
    window *= window;
    base = 25.0 / 16.0 * base - (25.0 / 16.0 - 1.0);
    float weight = base * window;
    color += tapColor * weight;
    totalWeight += weight;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, settings.outputSize))) {
        return;
    }
    vec2 position = vec2(pixel) * settings.scale + settings.offset;
    vec2 origin = floor(position);
    vec2 fraction = position - origin;
    ivec2 f0 = ivec2(origin);

    //      b c
    //    e f g h
    //    i j k l
    //      n o
    vec3 b = loadPerceptual(f0 + ivec2(0, -1));
    vec3 c = loadPerceptual(f0 + ivec2(1, -1));
    vec3 e = loadPerceptual(f0 + ivec2(-1, 0));
    vec3 f = loadPerceptual(f0);
    vec3 g = loadPerceptual(f0 + ivec2(1, 0));
    vec3 h = loadPerceptual(f0 + ivec2(2, 0));
    vec3 i = loadPerceptual(f0 + ivec2(-1, 1));
    vec3 j = loadPerceptual(f0 + ivec2(0, 1));
    vec3 k = loadPerceptual(f0 + ivec2(1, 1));
    vec3 l = loadPerceptual(f0 + ivec2(2, 1));
    vec3 n = loadPerceptual(f0 + ivec2(0, 2));
    vec3 o = loadPerceptual(f0 + ivec2(1, 2));
    float bL = approximateLuma(b);
    float cL = approximateLuma(c);
    float eL = approximateLuma(e);
    float fL = approximateLuma(f);
    float gL = approximateLuma(g);
    float hL = approximateLuma(h);
    float iL = approximateLuma(i);
    float jL = approximateLuma(j);
    float kL = approximateLuma(k);
    float lL = approximateLuma(l);
    float nL = approximateLuma(n);
    float oL = approximateLuma(o);

    vec2 direction = vec2(0.0);
    float edgeLength = 0.0;
    accumulateEdge(direction, edgeLength, (1.0 - fraction.x) * (1.0 - fraction.y), bL, eL, fL, gL, jL);
    accumulateEdge(direction, edgeLength, fraction.x * (1.0 - fraction.y), cL, fL, gL, hL, kL);
    accumulateEdge(direction, edgeLength, (1.0 - fraction.x) * fraction.y, fL, iL, jL, kL, nL);
    accumulateEdge(direction, edgeLength, fraction.x * fraction.y, gL, jL, kL, lL, oL);

    float directionSquared = dot(direction, direction);
    bool noEdge = directionSquared < 1.0 / 32768.0;
    float inverseLength = noEdge ? 1.0 : inversesqrt(directionSquared);
    direction.x = noEdge ? 1.0 : direction.x;
    direction *= inverseLength;
    // From {0 to 2} to {0 to 1}, shaped with a square.
    edgeLength *= 0.5;
    edgeLength *= edgeLength;
    // 1 for axis-aligned edges, sqrt(2) on diagonals.
    float stretch = dot(direction, direction) / max(max(abs(direction.x), abs(direction.y)), minimumDivisor);
    vec2 anisotropy = vec2(1.0 + (stretch - 1.0) * edgeLength, 1.0 - 0.5 * edgeLength);
    // The window shifts from +/-sqrt(2) toward slightly beyond 2 on edges.
    float lobe = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * edgeLength;
    float clip = 1.0 / lobe;

    vec3 color = vec3(0.0);
    float totalWeight = 0.0;
    accumulateTap(color, totalWeight, vec2(0.0, -1.0) - fraction, direction, anisotropy, lobe, clip, b);
    accumulateTap(color, totalWeight, vec2(1.0, -1.0) - fraction, direction, anisotropy, lobe, clip, c);
    accumulateTap(color, totalWeight, vec2(-1.0, 1.0) - fraction, direction, anisotropy, lobe, clip, i);
    accumulateTap(color, totalWeight, vec2(0.0, 1.0) - fraction, direction, anisotropy, lobe, clip, j);
    accumulateTap(color, totalWeight, vec2(0.0, 0.0) - fraction, direction, anisotropy, lobe, clip, f);
    accumulateTap(color, totalWeight, vec2(-1.0, 0.0) - fraction, direction, anisotropy, lobe, clip, e);
    accumulateTap(color, totalWeight, vec2(1.0, 1.0) - fraction, direction, anisotropy, lobe, clip, k);
    accumulateTap(color, totalWeight, vec2(2.0, 1.0) - fraction, direction, anisotropy, lobe, clip, l);
    accumulateTap(color, totalWeight, vec2(2.0, 0.0) - fraction, direction, anisotropy, lobe, clip, h);
    accumulateTap(color, totalWeight, vec2(1.0, 0.0) - fraction, direction, anisotropy, lobe, clip, g);
    accumulateTap(color, totalWeight, vec2(1.0, 2.0) - fraction, direction, anisotropy, lobe, clip, o);
    accumulateTap(color, totalWeight, vec2(0.0, 2.0) - fraction, direction, anisotropy, lobe, clip, n);

    // Dering: stay within the four nearest taps.
    vec3 minimum4 = min(min(f, g), min(j, k));
    vec3 maximum4 = max(max(f, g), max(j, k));
    vec3 filtered = totalWeight > minimumDivisor ? color / totalWeight : f;
    imageStore(upscaledOutput, pixel, vec4(min(maximum4, max(minimum4, filtered)), 1.0));
}
