#version 450
#extension GL_GOOGLE_include_directive : require

// Split-sum environment BRDF table: x = n.v, y = perceptual roughness, sampled at
// texel centers. Stores (scale, bias) so specular = prefiltered * (F0 * scale + bias)
// in rg (mirrors environment_lighting::integrateEnvironmentBrdf) and the
// directional albedo of a white Charlie sheen lobe in b, with y read as sheen
// roughness (mirrors environment_lighting::integrateSheenAlbedo).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray table;

layout(push_constant) uniform Settings {
    vec4 unused;
    uvec4 sizes; // x: table size, y: sample count
} settings;

#include "constants.glsl"

#include "importance_sampling.glsl"

float smithGeometryIbl(float nDotV, float nDotL, float roughness) {
    float k = roughness * roughness * 0.5;
    return nDotV / (nDotV * (1.0 - k) + k) * (nDotL / (nDotL * (1.0 - k) + k));
}

#include "sheen.glsl"

// Mirrors sheenAlbedoCosineSteps and sheenAlbedoAzimuthSteps.
const uint SHEEN_COSINE_STEPS = 16u;
const uint SHEEN_AZIMUTH_STEPS = 32u;

float integrateSheenAlbedo(float nDotV, float roughness) {
    float alpha = max(roughness * roughness, 1e-6);
    vec3 view = vec3(sqrt(1.0 - nDotV * nDotV), 0.0, nDotV);
    float sum = 0.0;
    for (uint row = 0u; row < SHEEN_COSINE_STEPS; ++row) {
        float nDotL = (float(row) + 0.5) / float(SHEEN_COSINE_STEPS);
        float sinTheta = sqrt(1.0 - nDotL * nDotL);
        for (uint column = 0u; column < SHEEN_AZIMUTH_STEPS; ++column) {
            float phi = 2.0 * PI * (float(column) + 0.5) / float(SHEEN_AZIMUTH_STEPS);
            vec3 light = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, nDotL);
            vec3 halfVector = normalize(view + light);
            sum += charlieDistribution(halfVector.z, alpha) * sheenVisibility(nDotL, nDotV, alpha) * nDotL;
        }
    }
    return sum * 2.0 * PI / float(SHEEN_COSINE_STEPS * SHEEN_AZIMUTH_STEPS);
}

void main() {
    uint size = settings.sizes.x;
    uvec2 texel = gl_GlobalInvocationID.xy;
    if (texel.x >= size || texel.y >= size) {
        return;
    }
    float nDotV = max((float(texel.x) + 0.5) / float(size), 1e-4);
    float roughness = (float(texel.y) + 0.5) / float(size);
    vec3 view = vec3(sqrt(1.0 - nDotV * nDotV), 0.0, nDotV);
    uint sampleCount = settings.sizes.y;
    vec2 result = vec2(0.0);
    for (uint sampleIndex = 0u; sampleIndex < sampleCount; ++sampleIndex) {
        vec3 halfVector = importanceSampleGgx(sampleIndex, sampleCount, roughness);
        vec3 light = 2.0 * dot(view, halfVector) * halfVector - view;
        float nDotL = max(light.z, 0.0);
        if (nDotL <= 0.0) {
            continue;
        }
        float nDotH = max(halfVector.z, 0.0);
        float vDotH = max(dot(view, halfVector), 0.0);
        float visibility = smithGeometryIbl(nDotV, nDotL, roughness) * vDotH / max(nDotH * nDotV, 1e-6);
        float fresnel = pow(1.0 - vDotH, 5.0);
        result += vec2((1.0 - fresnel) * visibility, fresnel * visibility);
    }
    imageStore(table, ivec3(texel, 0), vec4(result / float(sampleCount), integrateSheenAlbedo(nDotV, roughness), 1.0));
}
