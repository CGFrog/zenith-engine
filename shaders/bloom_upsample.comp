#version 450

// One bloom upsample step: a 3x3 tent filter of the smaller mip added to the
// next larger mip in place. Destination pixel p is centered on source texel
// coordinate (p + 0.5) / 2. outputScale normalizes the accumulated sum on the
// final step so the chain averages its levels instead of summing them.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba16f) uniform image2D destination;

layout(push_constant) uniform UpsampleSettings {
    vec2 sourceTexelSize;
    vec2 sourceUvLimit;
    uvec2 destinationExtent;
    float filterRadius;
    float outputScale;
} settings;

vec3 fetch(vec2 sourceTexel) {
    vec2 uv = min(sourceTexel * settings.sourceTexelSize, settings.sourceUvLimit);
    return textureLod(source, uv, 0.0).rgb;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, settings.destinationExtent))) {
        return;
    }
    vec2 center = (vec2(pixel) + 0.5) * 0.5;
    float r = settings.filterRadius;
    vec3 upsampled = fetch(center) * 4.0;
    upsampled += (fetch(center + vec2(-r, 0.0)) + fetch(center + vec2(r, 0.0)) + fetch(center + vec2(0.0, -r)) +
                  fetch(center + vec2(0.0, r))) *
                 2.0;
    upsampled += fetch(center + vec2(-r, -r)) + fetch(center + vec2(r, -r)) + fetch(center + vec2(-r, r)) +
                 fetch(center + vec2(r, r));
    upsampled *= 1.0 / 16.0;
    vec3 current = imageLoad(destination, ivec2(pixel)).rgb;
    imageStore(destination, ivec2(pixel), vec4((current + upsampled) * settings.outputScale, 1.0));
}
