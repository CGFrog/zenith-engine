#version 450

// Two-phase occlusion culling. The early phase emits objects that were visible
// last frame (frustum test only); they are drawn and the depth pyramid is built
// from that depth. The late phase tests every object against this frame's
// pyramid, records the result for the next frame, and emits only the objects
// the early phase did not draw.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint earlyPhase = 0u;

// Mirrors GpuDrivenObjectRecord in GpuDrivenPass.hpp.
struct ObjectRecord {
    mat4 model;
    mat4 previousModel;
    vec4 bounds;
    uvec4 draw; // x: LOD 0 batch index, y: persistent visibility slot, z: LOD level count
    uvec4 skin; // x: palette offset, y: joint count, z: material index
};

// Mirrors GpuDrivenBatch in GpuDrivenPass.hpp.
struct BatchRecord {
    uint indexCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
    uint group;
    uint groupFirstBatch;
    float lodGeometricError;
    uint nextLodBatch;
};

struct RenderObject {
    mat4 model;
    mat4 previousModel;
    uvec4 skin;
};

layout(std430, set = 0, binding = 0) readonly buffer ObjectRecords {
    ObjectRecord values[];
} records;

// Two regions of maximum-instance slots: early, then late.
layout(std430, set = 0, binding = 1) writeonly buffer VisibleObjects {
    RenderObject values[];
} visibleObjects;

// Two regions of maximumBatches counters: early, then late.
layout(std430, set = 0, binding = 2) buffer InstanceCounts {
    uint values[];
} instanceCounts;

layout(set = 0, binding = 3) uniform sampler2D depthPyramid;

// Persistent across frames: 1 when the slot's object passed the late test.
layout(std430, set = 0, binding = 4) buffer Visibility {
    uint values[];
} visibility;

// x: early instances emitted, y: late instances emitted.
layout(std430, set = 0, binding = 5) buffer Statistics {
    uint values[];
} statistics;

layout(std430, set = 0, binding = 6) readonly buffer Batches {
    BatchRecord values[];
} batches;

layout(push_constant) uniform Settings {
    mat4 viewProjection;
    uvec4 counts;   // x: objects, y: pyramid levels, z: phase, w: maximum instances
    uvec4 extents;  // x: maximum batches, y/z: pyramid render extent, w: visibility slots
    vec4 lodView;   // xyz: camera position, w: LOD error scale (0 = full detail only)
} settings;

bool frustumVisible(vec4 clipCenter, float clipRadius) {
    float w = clipCenter.w;
    return clipCenter.x >= -w - clipRadius && clipCenter.x <= w + clipRadius &&
           clipCenter.y >= -w - clipRadius && clipCenter.y <= w + clipRadius &&
           clipCenter.z >= -clipRadius && clipCenter.z <= w + clipRadius;
}

vec4 matrixRow(mat4 matrix, int row) {
    return vec4(matrix[0][row], matrix[1][row], matrix[2][row], matrix[3][row]);
}

// Tests the bounding sphere against this frame's depth pyramid. Every clip
// component is affine in world position, so over the sphere it lies within
// center +/- radius * |row.xyz|. Dividing those ranges by both extremes of w
// yields a screen rectangle and nearest depth that bound the whole sphere.
bool occluded(ObjectRecord object) {
    mat4 viewProjection = settings.viewProjection;
    vec4 center = viewProjection * vec4(object.bounds.xyz, 1.0);
    float radius = object.bounds.w;
    vec4 extent = radius * vec4(length(matrixRow(viewProjection, 0).xyz), length(matrixRow(viewProjection, 1).xyz),
                                length(matrixRow(viewProjection, 2).xyz), length(matrixRow(viewProjection, 3).xyz));
    float nearestW = center.w - extent.w;
    float farthestW = center.w + extent.w;
    if (nearestW <= 0.0001) {
        return false; // The sphere reaches the camera plane.
    }
    vec3 lower = (center.xyz - extent.xyz) / nearestW;
    vec3 upper = (center.xyz + extent.xyz) / nearestW;
    lower = min(lower, (center.xyz - extent.xyz) / farthestW);
    upper = max(upper, (center.xyz + extent.xyz) / farthestW);

    // Reversed Z: the nearest point has the largest depth.
    float nearestDepth = upper.z;
    // The pyramid covers the rendered top-left region of its storage; level L
    // spans max(renderSize >> L, 1) texels (DepthPyramidLayout.hpp).
    ivec2 renderSize = ivec2(settings.extents.yz);
    vec2 uvLower = clamp(lower.xy * 0.5 + 0.5, 0.0, 1.0);
    vec2 uvUpper = clamp(upper.xy * 0.5 + 0.5, 0.0, 1.0);
    ivec2 pixelLower = min(ivec2(uvLower * vec2(renderSize)), renderSize - 1);
    ivec2 pixelUpper = min(ivec2(uvUpper * vec2(renderSize)), renderSize - 1);

    // Pick the level where the rectangle spans at most two texels per axis.
    // Level texels cover base pixels p with min(p >> level, size - 1) == texel.
    ivec2 span = pixelUpper - pixelLower;
    int level = int(ceil(log2(float(max(max(span.x, span.y), 1)))));
    level = clamp(level, 0, int(settings.counts.y) - 1);
    ivec2 levelSize = max(renderSize >> level, ivec2(1));
    ivec2 texelLower = min(pixelLower >> level, levelSize - 1);
    ivec2 texelUpper = min(pixelUpper >> level, levelSize - 1);
    float farthestOccluder = min(min(texelFetch(depthPyramid, texelLower, level).r,
                                     texelFetch(depthPyramid, ivec2(texelUpper.x, texelLower.y), level).r),
                                 min(texelFetch(depthPyramid, ivec2(texelLower.x, texelUpper.y), level).r,
                                     texelFetch(depthPyramid, texelUpper, level).r));
    return nearestDepth < farthestOccluder;
}

// Mirrors selectMeshLod in MeshLodSelection.cpp: walks the object's chain of
// LOD batches and keeps the coarsest level whose geometric error, projected
// from the nearest point of the bounding sphere, stays within the threshold.
uint selectLodBatch(ObjectRecord object) {
    uint batchIndex = object.draw.x;
    float errorScale = settings.lodView.w;
    if (errorScale <= 0.0) {
        return batchIndex;
    }
    float worldScale = max(length(object.model[0].xyz), max(length(object.model[1].xyz), length(object.model[2].xyz)));
    float distance = max(length(object.bounds.xyz - settings.lodView.xyz) - object.bounds.w, 0.0);
    for (uint level = 1u; level < object.draw.z; ++level) {
        uint nextBatch = batches.values[batchIndex].nextLodBatch;
        if (batches.values[nextBatch].lodGeometricError * worldScale * errorScale > distance) {
            break;
        }
        batchIndex = nextBatch;
    }
    return batchIndex;
}

void emit(ObjectRecord object, uint phase) {
    uint batchIndex = selectLodBatch(object);
    uint slot = atomicAdd(instanceCounts.values[phase * settings.extents.x + batchIndex], 1u);
    uint outputIndex = phase * settings.counts.w + batches.values[batchIndex].firstInstance + slot;
    visibleObjects.values[outputIndex].model = object.model;
    visibleObjects.values[outputIndex].previousModel = object.previousModel;
    visibleObjects.values[outputIndex].skin = object.skin;
    atomicAdd(statistics.values[phase], 1u);
}

void main() {
    uint objectIndex = gl_GlobalInvocationID.x;
    if (objectIndex >= settings.counts.x) {
        return;
    }
    ObjectRecord object = records.values[objectIndex];
    vec4 clipCenter = settings.viewProjection * vec4(object.bounds.xyz, 1.0);
    float radius = object.bounds.w;
    float clipRadius = max(length((settings.viewProjection * vec4(radius, 0.0, 0.0, 0.0)).xyz),
                           max(length((settings.viewProjection * vec4(0.0, radius, 0.0, 0.0)).xyz),
                               length((settings.viewProjection * vec4(0.0, 0.0, radius, 0.0)).xyz)));
    bool inFrustum = frustumVisible(clipCenter, clipRadius);
    uint visibilitySlot = object.draw.y;
    bool trackedSlot = visibilitySlot < settings.extents.w;
    bool visibleLastFrame = trackedSlot && visibility.values[visibilitySlot] != 0u;
    uint phase = settings.counts.z;
    if (phase == earlyPhase) {
        if (visibleLastFrame && inFrustum) {
            emit(object, phase);
        }
        return;
    }
    bool visibleNow = inFrustum && !occluded(object);
    if (trackedSlot) {
        visibility.values[visibilitySlot] = visibleNow ? 1u : 0u;
    }
    // Objects the early phase drew are already in the depth buffer.
    bool drawnEarly = visibleLastFrame && inFrustum;
    if (visibleNow && !drawnEarly) {
        emit(object, phase);
    }
}
