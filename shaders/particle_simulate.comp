#version 450

// GPU particles, step 2: ages and moves every live particle of the pool,
// frees expired ones, culls the rest against the view, lights lit ones at
// their centers, and appends the visible ones to the sort keys and the
// indirect draw. Layouts and units are documented in
// src/engine/graphics/Particles.hpp; the pass in ParticlePass.cpp.

layout(local_size_x = 64) in;

const float PI = 3.14159265359;
const uint FLAG_LIT = 2u;
const uint FLAG_LOCAL_SPACE = 4u;

// Mirrors particles::GpuParticleFrame (std140).
layout(set = 0, binding = 0) uniform ParticleFrame {
    mat4 viewProjection;
    mat4 lightViewProjections[3];
    vec4 cameraPosition; // w: time step
    vec4 lightDirection; // xyz: toward the sun
    vec4 lightRadiance;
    vec4 cascadeSplits;
    vec4 clusterDepth;   // x, y: slice = log(depth) * x + y; z, w: projection[0][0], [1][1]
    uvec4 clusterGrid;   // columns, rows, slices, local light count
    uvec4 counts;        // x: pool slots, y: spawns, z: sort keys, w: shadow cascades
    vec4 ambient;        // rgb: hemisphere ambient radiance, w: environment diffuse intensity
    uvec4 flags;         // x: ambient from the irradiance SH, y: emitter count
    vec4 irradianceVolumeMinimum;
    vec4 irradianceVolumeCellSize;
    uvec4 irradianceVolumeCounts;
} frame;

// Mirrors particles::GpuParticleEmitter (std430).
struct Emitter {
    mat4 localToWorld;
    vec4 gravityDrag;
    vec4 direction;
    vec4 speedLifetime;
    vec4 sizeSpin; // x, y: start and end size, z: angular speed
    vec4 startColor;
    vec4 endColor;
    vec4 shading; // x: emissive intensity, y: soft distance
    uvec4 pool;
    uvec4 spawn;
};

layout(std430, set = 0, binding = 1) readonly buffer Emitters {
    Emitter values[];
} emitters;

// Mirrors particles::GpuParticle (std430).
struct Particle {
    vec4 positionAge;
    vec4 velocityLifetime;
    vec4 worldPositionSize;
    vec4 radiance;
    vec4 render;
    uvec4 info;
};

layout(std430, set = 0, binding = 2) buffer Particles {
    Particle values[];
} particles;

// Mirrors particles::SortKey.
layout(std430, set = 0, binding = 3) writeonly buffer SortKeys {
    uvec2 values[];
} sortKeys;

// VkDrawIndirectCommand; instanceCount counts this frame's visible particles.
layout(std430, set = 0, binding = 4) buffer DrawArguments {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} drawArguments;

layout(set = 0, binding = 5) uniform sampler2DArrayShadow shadowMap;

// Mirrors GpuLocalLight in ClusteredLightingPass.hpp (std430).
struct LocalLight {
    vec4 positionRange;
    vec4 colorIntensity;
    vec4 directionType;
    vec4 spotCone;
};

layout(std430, set = 0, binding = 6) readonly buffer LocalLights {
    LocalLight values[];
} localLights;

layout(std430, set = 0, binding = 7) readonly buffer ClusterRanges {
    uvec2 values[];
} clusterRanges;

layout(std430, set = 0, binding = 8) readonly buffer ClusterLightIndices {
    uint values[];
} clusterLightIndices;

// Order-2 SH of irradiance / pi (EnvironmentPass).
layout(std430, set = 0, binding = 9) readonly buffer EnvironmentIrradiance {
    vec4 coefficients[9];
} environmentIrradiance;

// Mirrors IrradianceProbe in mesh.frag and irradiance_volume::GpuProbe.
const int IRRADIANCE_PROBE_DEPTH_RESOLUTION = 8;
struct IrradianceProbe {
    vec4 irradiance[9];
    vec2 depthMoments[IRRADIANCE_PROBE_DEPTH_RESOLUTION * IRRADIANCE_PROBE_DEPTH_RESOLUTION];
};

layout(std430, set = 0, binding = 10) readonly buffer IrradianceVolumeProbes {
    IrradianceProbe probes[];
} irradianceVolume;

// Mirrors particles::backToFrontKey.
uint backToFrontKey(float viewDepth) {
    return 0xffffffffu - floatBitsToUint(max(viewDepth, 0.0));
}

float hashToUnit(uint value) {
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return float(((word >> 22u) ^ word) >> 8u) * (1.0 / 16777216.0);
}

// One hardware-filtered tap of the cascade covering the point, as the fog
// injection does; unshadowed outside every cascade.
float sunVisibility(vec3 world) {
    uint cascadeCount = frame.counts.w;
    if (cascadeCount == 0u) {
        return 1.0;
    }
    float cameraDistance = length(world - frame.cameraPosition.xyz);
    for (uint cascade = 0u; cascade < cascadeCount; ++cascade) {
        if (cascadeCount > 1u && cameraDistance > frame.cascadeSplits[cascade]) {
            continue;
        }
        vec4 clip = frame.lightViewProjections[cascade] * vec4(world, 1.0);
        vec3 projected = clip.xyz / clip.w;
        vec2 uv = projected.xy * 0.5 + 0.5;
        if (projected.z <= 0.0 || projected.z >= 1.0 || any(lessThan(uv, vec2(0.0))) ||
            any(greaterThan(uv, vec2(1.0)))) {
            return 1.0;
        }
        return texture(shadowMap, vec4(uv, float(cascade), projected.z));
    }
    return 1.0;
}

// Irradiance from the clustered local lights at the particle center. The
// cluster comes from the projected center, clamped to the grid for particles
// whose center is just outside the view.
vec3 localLightIrradiance(vec3 world, vec4 clip) {
    if (frame.clusterGrid.w == 0u) {
        return vec3(0.0);
    }
    vec2 screen = clamp(clip.xy / clip.w * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    uvec2 tile = min(uvec2(screen * vec2(frame.clusterGrid.xy)), frame.clusterGrid.xy - 1u);
    float slice = log(max(clip.w, 0.0001)) * frame.clusterDepth.x + frame.clusterDepth.y;
    uint depthSlice = min(uint(max(slice, 0.0)), frame.clusterGrid.z - 1u);
    uint cluster = tile.x + frame.clusterGrid.x * (tile.y + frame.clusterGrid.y * depthSlice);
    uvec2 range = clusterRanges.values[cluster];
    vec3 irradiance = vec3(0.0);
    for (uint entry = 0u; entry < range.y; ++entry) {
        LocalLight light = localLights.values[clusterLightIndices.values[range.x + entry]];
        vec3 toLight = light.positionRange.xyz - world;
        float distanceToLight = length(toLight);
        float lightRange = light.positionRange.w;
        if (distanceToLight >= lightRange || distanceToLight <= 0.0001) {
            continue;
        }
        // Mirrors the local-light attenuation in mesh.frag.
        float attenuation =
            pow(max(1.0 - distanceToLight / lightRange, 0.0), 2.0) / max(distanceToLight * distanceToLight, 0.01);
        if (light.directionType.w > 0.5) {
            float coneCosine = dot(-toLight / distanceToLight, normalize(light.directionType.xyz));
            attenuation *= smoothstep(light.spotCone.y, light.spotCone.x, coneCosine);
        }
        irradiance += light.colorIntensity.rgb * light.colorIntensity.w * attenuation;
    }
    return irradiance;
}

// Octahedral lookup and Chebyshev test mirror the irradiance volume functions
// in mesh.frag and volumetric_fog_inject.comp.
vec2 signNotZero(vec2 value) {
    return vec2(value.x >= 0.0 ? 1.0 : -1.0, value.y >= 0.0 ? 1.0 : -1.0);
}

vec2 octahedralEncode(vec3 direction) {
    vec2 projected = direction.xz / (abs(direction.x) + abs(direction.y) + abs(direction.z));
    if (direction.y < 0.0) {
        projected = (1.0 - abs(projected.yx)) * signNotZero(projected);
    }
    return projected * 0.5 + 0.5;
}

vec2 probeDepthTexel(uint probe, ivec2 texel) {
    texel = clamp(texel, ivec2(0), ivec2(IRRADIANCE_PROBE_DEPTH_RESOLUTION - 1));
    return irradianceVolume.probes[probe].depthMoments[texel.y * IRRADIANCE_PROBE_DEPTH_RESOLUTION + texel.x];
}

vec2 sampleProbeDepth(uint probe, vec3 direction) {
    vec2 texel = octahedralEncode(direction) * float(IRRADIANCE_PROBE_DEPTH_RESOLUTION) - 0.5;
    vec2 base = floor(texel);
    vec2 fraction = texel - base;
    ivec2 corner = ivec2(base);
    vec2 top = mix(probeDepthTexel(probe, corner), probeDepthTexel(probe, corner + ivec2(1, 0)), fraction.x);
    vec2 bottom =
        mix(probeDepthTexel(probe, corner + ivec2(0, 1)), probeDepthTexel(probe, corner + ivec2(1, 1)), fraction.x);
    return mix(top, bottom, fraction.y);
}

float chebyshevVisibility(vec2 moments, float distanceToProbe) {
    if (distanceToProbe <= moments.x) {
        return 1.0;
    }
    float variance = max(moments.y - moments.x * moments.x, 0.0001);
    float delta = distanceToProbe - moments.x;
    float probability = variance / (variance + delta * delta);
    return probability * probability * probability;
}

// Mirrors irradiance_volume::sampleMeanRadiance (see volumeMeanRadiance in
// volumetric_fog_inject.comp): rgb mean radiance, a edge weight.
vec4 volumeMeanRadiance(vec3 world) {
    uvec3 counts = frame.irradianceVolumeCounts.xyz;
    vec3 minimum = frame.irradianceVolumeMinimum.xyz;
    vec3 cellSize = frame.irradianceVolumeCellSize.xyz;
    vec3 inside = min(world - minimum, minimum + cellSize * vec3(counts) - world);
    float edgeDistance = min(inside.x, min(inside.y, inside.z));
    if (edgeDistance < 0.0) {
        return vec4(0.0);
    }
    float blendDistance = frame.irradianceVolumeCellSize.w;
    float edge = blendDistance <= 0.0 ? 1.0 : min(edgeDistance / blendDistance, 1.0);
    vec3 lastProbe = vec3(counts) - 1.0;
    vec3 lattice = clamp((world - minimum) / cellSize - 0.5, vec3(0.0), lastProbe);
    vec3 base = min(floor(lattice), max(lastProbe - 1.0, vec3(0.0)));
    vec3 alpha = clamp(lattice - base, vec3(0.0), vec3(1.0));
    vec3 radiance = vec3(0.0);
    float totalWeight = 0.0;
    for (uint corner = 0u; corner < 8u; ++corner) {
        uvec3 offset = uvec3(corner & 1u, (corner >> 1u) & 1u, (corner >> 2u) & 1u);
        vec3 trilinearAxes = mix(1.0 - alpha, alpha, vec3(offset));
        float trilinear = trilinearAxes.x * trilinearAxes.y * trilinearAxes.z;
        uvec3 index = min(uvec3(base) + offset, counts - 1u);
        uint probe = index.x + counts.x * (index.y + counts.y * index.z);
        if (irradianceVolume.probes[probe].irradiance[0].w < 0.5 || trilinear <= 0.0) {
            continue;
        }
        vec3 probeToPoint = world - (minimum + (vec3(index) + 0.5) * cellSize);
        float pointDistance = length(probeToPoint);
        float weight = 1.0;
        if (pointDistance > 0.0001) {
            weight = chebyshevVisibility(sampleProbeDepth(probe, probeToPoint / pointDistance), pointDistance);
        }
        weight = max(weight, 0.000001) * trilinear;
        radiance += max(irradianceVolume.probes[probe].irradiance[0].rgb * 0.282095, vec3(0.0)) * weight;
        totalWeight += weight;
    }
    if (totalWeight <= 0.0) {
        return vec4(0.0);
    }
    return vec4(radiance / totalWeight, edge);
}

// Mean ambient radiance around the particle (the order-0 SH term), replaced
// by the irradiance volume's probes inside its box.
vec3 ambientRadiance(vec3 world) {
    vec3 ambient = frame.ambient.rgb;
    if (frame.flags.x != 0u) {
        ambient = max(environmentIrradiance.coefficients[0].rgb * 0.282095, vec3(0.0)) * frame.ambient.w;
    }
    if (frame.irradianceVolumeCounts.w != 0u) {
        vec4 volume = volumeMeanRadiance(world);
        ambient = mix(ambient, volume.rgb * frame.irradianceVolumeMinimum.w, volume.a);
    }
    return ambient;
}

// Light a white lit particle reflects toward the eye: a Lambertian card
// facing every light ((sun + local) / pi) plus the mean ambient radiance,
// matching the diffuse terms of mesh.frag.
vec3 receivedLight(vec3 world, vec4 clip) {
    vec3 sun = frame.lightRadiance.rgb * sunVisibility(world);
    return (sun + localLightIrradiance(world, clip)) / PI + ambientRadiance(world);
}

void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= frame.counts.x) {
        return;
    }
    Particle particle = particles.values[slot];
    float lifetime = particle.velocityLifetime.w;
    if (lifetime <= 0.0) {
        return;
    }
    float step = frame.cameraPosition.w;
    float age = particle.positionAge.w + step;
    if (age >= lifetime) {
        particles.values[slot].velocityLifetime.w = 0.0;
        return;
    }
    Emitter emitter = emitters.values[particle.info.x];
    vec3 velocity = (particle.velocityLifetime.xyz + emitter.gravityDrag.xyz * step) * exp(-emitter.gravityDrag.w * step);
    vec3 position = particle.positionAge.xyz + velocity * step;
    particles.values[slot].positionAge = vec4(position, age);
    particles.values[slot].velocityLifetime.xyz = velocity;

    // The emitter's current flags (blend mode, lighting, sprite slot) apply
    // to its live particles too; its space cannot change while they live
    // (see particles::ParticleScheduler).
    uint flags = emitter.spawn.w;
    vec3 world = (flags & FLAG_LOCAL_SPACE) != 0u ? (emitter.localToWorld * vec4(position, 1.0)).xyz : position;
    float t = clamp(age / lifetime, 0.0, 1.0);
    float size = mix(emitter.sizeSpin.x, emitter.sizeSpin.y, t);
    vec4 color = mix(emitter.startColor, emitter.endColor, t);
    vec4 clip = frame.viewProjection * vec4(world, 1.0);
    // Conservative view test of the billboard's bounding sphere.
    float radius = size * 0.7072;
    vec2 extent = radius * abs(frame.clusterDepth.zw);
    if (clip.w + radius <= 0.0 || color.a <= 0.0 || size <= 0.0 || any(greaterThan(abs(clip.xy) - extent, vec2(clip.w)))) {
        return;
    }
    vec3 light = vec3(emitter.shading.x);
    if ((flags & FLAG_LIT) != 0u) {
        light += receivedLight(world, clip);
    }
    float spin = (hashToUnit(particle.info.y ^ 0x68e31da4u) * 2.0 - 1.0) * emitter.sizeSpin.z;
    float rotation = hashToUnit(particle.info.y ^ 0xb5297a4du) * 2.0 * PI + spin * age;
    particles.values[slot].worldPositionSize = vec4(world, size);
    particles.values[slot].radiance = vec4(color.rgb * light, color.a);
    particles.values[slot].render = vec4(rotation, emitter.shading.y, 0.0, 0.0);
    particles.values[slot].info.z = flags;

    uint drawIndex = atomicAdd(drawArguments.instanceCount, 1u);
    if (drawIndex < frame.counts.z) {
        sortKeys.values[drawIndex] = uvec2(backToFrontKey(clip.w), slot);
    }
}
