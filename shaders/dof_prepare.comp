#version 450
#extension GL_GOOGLE_include_directive : require

// Depth of field, step 1 of 3: downsamples the HDR scene to the
// half-resolution gather target and stores each texel's signed circle of
// confusion. The CoC math mirrors src/engine/graphics/DepthOfField.cpp; keep
// them in sync.

layout(local_size_x = 8, local_size_y = 8) in;

// Output-sized images whose top-left fullSize (scene) and depthSize (motion)
// texels hold this frame.
layout(set = 0, binding = 0) uniform sampler2D sceneColor;
// xy: motion, z: reactive mask, w: reversed-Z depth (near = 1, far = 0).
layout(set = 0, binding = 1) uniform sampler2D motionDepth;
// rgb: averaged scene color, a: signed CoC radius in half-resolution pixels.
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D prepared;

#include "depth_of_field.glsl"

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(settings.gatherSize.xy)))) {
        return;
    }
    ivec2 lastPixel = ivec2(settings.fullSize.xy) - 1;
    vec3 color = vec3(0.0);
    float circle = 0.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 pixel = min(texel * 2 + ivec2(x, y), lastPixel);
            color += max(texelFetch(sceneColor, pixel, 0).rgb, vec3(0.0));
            circle += circleOfConfusion(motionDepth, pixel);
        }
    }
    // Averages, with the radius converted to half-resolution pixels.
    imageStore(prepared, texel, vec4(color * 0.25, circle * 0.125));
}
