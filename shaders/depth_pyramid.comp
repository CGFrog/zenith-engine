#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D sourceDepth;
layout(set = 0, binding = 1) uniform sampler2D sourcePyramid;
layout(r32f, set = 0, binding = 2) uniform writeonly image2D outputMip;

layout(push_constant) uniform Settings {
    ivec2 outputSize;
    int sourceMip;
    int copyDepth;
} settings;

// Each texel stores the farthest depth it covers. Scene depth is reversed Z
// (near = 1, far = 0), so the farthest occluder is the minimum.
void main() {
    ivec2 outputCoordinate = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(outputCoordinate, settings.outputSize))) {
        return;
    }
    float farthestDepth;
    if (settings.copyDepth != 0) {
        farthestDepth = texelFetch(sourceDepth, outputCoordinate, 0).r;
    } else {
        // Levels halve with truncation, so on an odd source axis the last output
        // texel must also cover the leftover third source texel to stay conservative.
        ivec2 sourceSize = textureSize(sourcePyramid, settings.sourceMip);
        ivec2 sourceBegin = outputCoordinate * 2;
        ivec2 sourceEnd = sourceBegin + 2;
        bvec2 lastOutput = equal(outputCoordinate, settings.outputSize - 1);
        sourceEnd = mix(sourceEnd, sourceSize, lastOutput);
        sourceEnd = min(sourceEnd, sourceSize);
        farthestDepth = 1.0;
        for (int y = sourceBegin.y; y < sourceEnd.y; ++y) {
            for (int x = sourceBegin.x; x < sourceEnd.x; ++x) {
                farthestDepth = min(farthestDepth, texelFetch(sourcePyramid, ivec2(x, y), settings.sourceMip).r);
            }
        }
    }
    imageStore(outputMip, outputCoordinate, vec4(farthestDepth));
}
