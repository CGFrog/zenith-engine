#version 450

// GPU particles, step 1: writes this frame's new particles into their
// emitters' rings. One thread per spawn; every random value derives from the
// emitter seed and the spawn ordinal, so the result does not depend on thread
// scheduling. Layouts and units are documented in
// src/engine/graphics/Particles.hpp; the pass in ParticlePass.cpp.

layout(local_size_x = 64) in;

const float PI = 3.14159265359;
const uint FLAG_LOCAL_SPACE = 4u;

// Mirrors particles::GpuParticleFrame (std140).
layout(set = 0, binding = 0) uniform ParticleFrame {
    mat4 viewProjection;
    mat4 lightViewProjections[3];
    vec4 cameraPosition; // w: time step
    vec4 lightDirection;
    vec4 lightRadiance;
    vec4 cascadeSplits;
    vec4 clusterDepth;
    uvec4 clusterGrid;
    uvec4 counts; // x: pool slots, y: spawns, z: sort keys, w: shadow cascades
    vec4 ambient;
    uvec4 flags; // y: emitter count
    vec4 irradianceVolumeMinimum;
    vec4 irradianceVolumeCellSize;
    uvec4 irradianceVolumeCounts;
} frame;

// Mirrors particles::GpuParticleEmitter (std430).
struct Emitter {
    mat4 localToWorld;
    vec4 gravityDrag;
    vec4 direction; // xyz: entity-space cone axis, w: cosine of the half angle
    vec4 speedLifetime;
    vec4 sizeSpin; // w: spawn radius
    vec4 startColor;
    vec4 endColor;
    vec4 shading;
    uvec4 pool;  // first slot, capacity, ring start, spawn count
    uvec4 spawn; // spawn offset, first ordinal, seed, flags
};

layout(std430, set = 0, binding = 1) readonly buffer Emitters {
    Emitter values[];
} emitters;

// Mirrors particles::GpuParticle (std430).
struct Particle {
    vec4 positionAge;
    vec4 velocityLifetime;
    vec4 worldPositionSize;
    vec4 radiance;
    vec4 render;
    uvec4 info;
};

layout(std430, set = 0, binding = 2) buffer Particles {
    Particle values[];
} particles;

// PCG hash (Jarzynski and Olano, "Hash Functions for GPU Rendering").
uint pcgHash(uint value) {
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float nextRandom(inout uint state) {
    state = pcgHash(state);
    return float(state >> 8u) * (1.0 / 16777216.0);
}

// Uniform direction inside a cone of the given cosine around +z.
vec3 coneDirection(inout uint state, float cosineLimit) {
    float cosine = mix(1.0, cosineLimit, nextRandom(state));
    float sine = sqrt(max(1.0 - cosine * cosine, 0.0));
    float angle = 2.0 * PI * nextRandom(state);
    return vec3(cos(angle) * sine, sin(angle) * sine, cosine);
}

mat3 basisAround(vec3 axis) {
    vec3 helper = abs(axis.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(helper, axis));
    return mat3(tangent, cross(axis, tangent), axis);
}

void main() {
    uint spawnIndex = gl_GlobalInvocationID.x;
    if (spawnIndex >= frame.counts.y) {
        return;
    }
    uint emitterIndex = 0u;
    for (uint index = 0u; index < frame.flags.y; ++index) {
        uvec4 spawn = emitters.values[index].spawn;
        if (spawnIndex >= spawn.x && spawnIndex < spawn.x + emitters.values[index].pool.w) {
            emitterIndex = index;
            break;
        }
    }
    Emitter emitter = emitters.values[emitterIndex];
    uint spawnInEmitter = spawnIndex - emitter.spawn.x;
    uint slot = emitter.pool.x + (emitter.pool.z + spawnInEmitter) % emitter.pool.y;
    uint seed = pcgHash(emitter.spawn.z ^ pcgHash(emitter.spawn.y + spawnInEmitter));
    uint state = seed;

    vec3 offset = vec3(0.0);
    if (emitter.sizeSpin.w > 0.0) {
        offset = coneDirection(state, -1.0) * emitter.sizeSpin.w * pow(nextRandom(state), 1.0 / 3.0);
    }
    vec3 direction = basisAround(normalize(emitter.direction.xyz)) * coneDirection(state, emitter.direction.w);
    float speed = mix(emitter.speedLifetime.x, emitter.speedLifetime.y, nextRandom(state));
    float lifetime = mix(emitter.speedLifetime.z, emitter.speedLifetime.w, nextRandom(state));
    vec3 position = offset;
    vec3 velocity = direction * speed;
    uint flags = emitter.spawn.w;
    if ((flags & FLAG_LOCAL_SPACE) == 0u) {
        // World particles leave the entity's current transform behind.
        position = (emitter.localToWorld * vec4(offset, 1.0)).xyz;
        vec3 worldDirection = mat3(emitter.localToWorld) * direction;
        float directionLength = length(worldDirection);
        velocity = directionLength > 0.0 ? worldDirection / directionLength * speed : vec3(0.0);
    }
    // Spawns spread across the step: the k-th of n happens (k + 0.5) / n of
    // the way through it, so it starts that far behind and simulate (which
    // advances one full step) leaves continuous streams evenly spaced instead
    // of in per-frame clumps.
    float lateness = (float(spawnInEmitter) + 0.5) / float(max(emitter.pool.w, 1u)) * frame.cameraPosition.w;
    particles.values[slot].positionAge = vec4(position - velocity * lateness, -lateness);
    particles.values[slot].velocityLifetime = vec4(velocity, max(lifetime, 0.0001));
    particles.values[slot].info = uvec4(emitterIndex, seed, flags, 0u);
}
