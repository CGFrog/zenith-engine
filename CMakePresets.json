{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (build/)",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Debug, every test",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "debug-cpu",
      "displayName": "Debug, CPU-only tests",
      "inherits": "debug",
      "filter": {
        "exclude": {
          "label": "vulkan|benchmark"
        }
      }
    }
  ]
}
