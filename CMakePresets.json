{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (build/)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "worktree",
      "displayName": "Worktree (build/, dependency sources from $env{ZENITH_SHARED_DEPS_DIR})",
      "inherits": "default",
      "cacheVariables": {
        "ZENITH_SHARED_DEPS_DIR": "$env{ZENITH_SHARED_DEPS_DIR}",
        "FETCHCONTENT_FULLY_DISCONNECTED": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "worktree",
      "displayName": "Debug (worktree configure preset)",
      "configurePreset": "worktree",
      "configuration": "Debug",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "tests-base",
      "hidden": true,
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "unit",
      "displayName": "Unit tests: CPU-only, fast (the everyday loop)",
      "inherits": "tests-base",
      "filter": {
        "include": {
          "label": "^unit$"
        }
      }
    },
    {
      "name": "cpu",
      "displayName": "CPU tests: unit and slow (what CI runs without a GPU)",
      "inherits": "tests-base",
      "filter": {
        "include": {
          "label": "^(unit|slow)$"
        },
        "exclude": {
          "label": "^benchmark$"
        }
      }
    },
    {
      "name": "gpu",
      "displayName": "GPU tests: smokes, validation, captures (needs a Vulkan device)",
      "inherits": "tests-base",
      "filter": {
        "include": {
          "label": "^vulkan$"
        },
        "exclude": {
          "label": "^benchmark$"
        }
      }
    },
    {
      "name": "benchmark",
      "displayName": "Benchmarks: run for their numbers",
      "inherits": "tests-base",
      "filter": {
        "include": {
          "label": "^benchmark$"
        }
      }
    },
    {
      "name": "all",
      "displayName": "Every test",
      "inherits": "tests-base"
    }
  ]
}
