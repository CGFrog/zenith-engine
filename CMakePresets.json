{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (build/)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "worktree",
      "displayName": "Worktree (build/, dependency sources from $env{ZENITH_SHARED_DEPS_DIR})",
      "inherits": "default",
      "cacheVariables": {
        "ZENITH_SHARED_DEPS_DIR": "$env{ZENITH_SHARED_DEPS_DIR}",
        "FETCHCONTENT_FULLY_DISCONNECTED": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "worktree",
      "displayName": "Debug (worktree configure preset)",
      "configurePreset": "worktree",
      "configuration": "Debug",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Debug, every test",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "debug-cpu",
      "displayName": "Debug, CPU-only tests",
      "inherits": "debug",
      "filter": {
        "exclude": {
          "label": "vulkan|benchmark|slow"
        }
      }
    }
  ]
}
