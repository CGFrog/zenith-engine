# Generated when Zenith is configured: the Zenith::Engine imported target, for
# game modules built outside the Zenith tree (see templates/cpp_game). Include
# this file from a module's CMakeLists.txt and link the module to
# Zenith::Engine. Each configuration's library paths are in
# ZenithEngineTargets-<config>.cmake beside this file.
include_guard(GLOBAL)

set(ZENITH_ENGINE_SOURCE_DIR "@CMAKE_CURRENT_SOURCE_DIR@")
set(ZENITH_ENGINE_BUILD_DIR "@CMAKE_CURRENT_BINARY_DIR@")

# Engine types cross the module boundary by reference, so a module is only
# loaded when it was compiled with the engine's compiler (the module build
# hash). Refuse a mismatch here rather than at load time.
set(_zenith_engine_compiler_id "@CMAKE_CXX_COMPILER_ID@")
set(_zenith_engine_compiler_version "@CMAKE_CXX_COMPILER_VERSION@")
string(REGEX MATCH "^[0-9]+\\.[0-9]+" _zenith_engine_compiler_release "${_zenith_engine_compiler_version}")
string(REGEX MATCH "^[0-9]+\\.[0-9]+" _zenith_module_compiler_release "${CMAKE_CXX_COMPILER_VERSION}")
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL _zenith_engine_compiler_id
        OR NOT _zenith_module_compiler_release STREQUAL _zenith_engine_compiler_release)
    message(FATAL_ERROR
        "Zenith at ${ZENITH_ENGINE_BUILD_DIR} was built with ${_zenith_engine_compiler_id} "
        "${_zenith_engine_compiler_version}, but this project uses ${CMAKE_CXX_COMPILER_ID} "
        "${CMAKE_CXX_COMPILER_VERSION}. Configure with the engine's generator and compiler (the project's "
        "CMakePresets.json names them), for example: cmake --preset zenith")
endif()

add_library(Zenith::SDL3 SHARED IMPORTED)
add_library(Zenith::Engine SHARED IMPORTED)
set_target_properties(Zenith::Engine PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "$<TARGET_PROPERTY:zenith_engine,INTERFACE_INCLUDE_DIRECTORIES>"
    INTERFACE_COMPILE_DEFINITIONS "$<TARGET_PROPERTY:zenith_engine,INTERFACE_COMPILE_DEFINITIONS>"
    INTERFACE_COMPILE_FEATURES cxx_std_20
    INTERFACE_LINK_LIBRARIES Zenith::SDL3
)

file(GLOB _zenith_engine_configurations "${CMAKE_CURRENT_LIST_DIR}/ZenithEngineTargets-*.cmake")
foreach(_zenith_engine_configuration IN LISTS _zenith_engine_configurations)
    include("${_zenith_engine_configuration}")
endforeach()
